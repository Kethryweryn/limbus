generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id             String     @id @default(cuid())
  title          String
  description    String
  noteIntention  String?
  teaserUrl      String?
  slug           String     @unique
  ownerId        String?
  owner          User?      @relation("OwnedGames", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  published      Boolean    @default(true)
  publicPage     Boolean    @default(false)
  // Ce que la page publique montre en plus de la présentation (US-086, ADR-0046)
  publicShowSessions     Boolean @default(false)
  publicShowRegistration Boolean @default(false)
  // Attribut d'équilibre des personnages (US-091, ADR-0048) : son nom et ses valeurs, par exemple « Genre du personnage »
  balanceAttribute String?
  balanceValues    String[]  @default([])
  // Un seul PJ par participant et par session (US-017) ; décoché pour un jeu en plusieurs actes
  singlePjPerParticipant Boolean @default(true)
  // Photos des participants (US-107, US-108, ADR-0054) : durée de conservation après la session, et adresse donnée
  // pour en demander le retrait (à défaut, celle de la propriétaire)
  photoRetentionMonths Int @default(6)
  contactEmail   String?
  // Crédit d'une copie léguée, figé au moment du legs (SPEC-002 R11, R12, ADR-0025)
  creditSourceTitle String?
  creditAuthorName  String?
  // Jeu d'origine d'une copie : sert à lister ses legs en attente, ne donne aucun droit
  copiedFromGameId  String?
  copiedFrom        Game?      @relation("GameCopies", fields: [copiedFromGameId], references: [id], onDelete: SetNull)
  copies            Game[]     @relation("GameCopies")
  // Copie léguée dont la destinataire n'a pas encore de compte : invisible pour tous (R8)
  bequestPending    Boolean    @default(false)
  // Transfert proposé à une co-organisatrice (US-060, ADR-0038) : le jeu change de main quand elle accepte
  transferToUserId  String?
  transferTo        User?      @relation("GameTransfers", fields: [transferToUserId], references: [id], onDelete: SetNull)
  // Les co-organisatrices peuvent y brancher leur assistant d'IA (SPEC-014, R5) : décidé par la propriétaire
  aiForCoorganizers Boolean   @default(false)

  characters     Character[]
  factions       Faction[]
  intrigues      Intrigue[]
  items          Item[]
  timelineEvents TimelineEvent[]
  sessions       Session[]
  documents      Document[]
  locations      Location[]
  uploadedFiles  UploadedFile[]
  participantLinks ParticipantGame[]
  shares         GameShare[]
  invitations    GameInvitation[]
  registrationPeriods RegistrationPeriod[]
  slugRedirects  GameSlugRedirect[]
  registrationForm RegistrationForm?
  characterRelations CharacterRelation[]
  registrationQuestionLinks RegistrationQuestionLink[]
  registrationOptionExpectations RegistrationOptionExpectation[]
  aiAuthorizationGames AiAuthorizationGame[]
  aiLogEntries AiLogEntry[]

  @@index([ownerId])
  @@index([copiedFromGameId])
  @@index([transferToUserId])
}

model Character {
  id                    String     @id @default(cuid())
  name                  String
  type                  CharacterType @default(pj)
  pitch                 String?
  background            String?
  backgroundDocumentUrl String?
  sheetReadyToSend      Boolean    @default(false)
  costumeIndications    String?
  excludeFromTrombinoscope Boolean @default(false)
  trombinoscopeFaceHidden  Boolean @default(false)
  trombinoscopePhotoUrl    String?
  trombinoscopeNote        String?
  trombinoscopeDisplayName String?
  // Valeur de l'attribut d'équilibre du jeu (US-091, ADR-0048)
  balanceValue          String?
  slug                  String     @unique
  gameId                String
  game                  Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  published             Boolean    @default(true)

  factionLinks          CharacterFaction[]
  intrigueLinks         CharacterIntrigue[]
  // Documents de l'ancien champ « Personnage » (Document.characterId), vide depuis ADR-0072 et retiré par l'US-193
  legacyDocuments       Document[]
  documentLinks         DocumentCharacter[]
  sessionAssignments    SessionAssignment[]
  itemLinks             CharacterItem[]
  locatedItems          Item[]      @relation("ItemLocationCharacter")
  timelineEventLinks    TimelineEventCharacter[]
  documentDeliveries    SessionDocumentDelivery[]
  trombinoscopeViewerEntries CharacterTrombinoscopeEntry[] @relation("TrombinoscopeViewerEntries")
  trombinoscopeTargetEntries CharacterTrombinoscopeEntry[] @relation("TrombinoscopeTargetEntries")
  trombinoscopeDocuments SessionTrombinoscope[] @relation("TrombinoscopeViewerDocuments")
  // Relations entre personnages (US-097, ADR-0050), de chaque côté
  relationsFrom         CharacterRelation[] @relation("RelationFrom")
  relationsTo           CharacterRelation[] @relation("RelationTo")
  questionLinks         RegistrationQuestionLink[]

  @@index([gameId])
  // Cible des clés composées avec le jeu (US-191, ADR-0074)
  @@unique([id, gameId])
}

// Relation entre deux personnages du jeu (US-097, ADR-0050) : un type, une description commune, et pour chaque côté
// un libellé facultatif et une visibilité dans la fiche envoyée au joueur. Écrite à la main (US-190, ADR-0073) :
// CharacterRelation_deux_personnages_check, un personnage n'est pas relié à lui-même
model CharacterRelation {
  id              String    @id @default(cuid())
  gameId          String
  game            Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  // romance, family, rivalry, alliance, hierarchy ou other
  type            CharacterRelationType
  description     String?
  fromCharacterId String
  fromCharacter   Character @relation("RelationFrom", fields: [fromCharacterId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  fromLabel       String?
  fromVisible     Boolean   @default(false)
  toCharacterId   String
  toCharacter     Character @relation("RelationTo", fields: [toCharacterId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  toLabel         String?
  toVisible       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([gameId])
  @@index([fromCharacterId, gameId])
  @@index([toCharacterId, gameId])
}

// Une option d'une question du formulaire (vide pour une question sur une échelle) reliée à un personnage, une faction
// ou une intrigue (US-098, ADR-0050) ; hors des versions du formulaire. Écrits à la main (US-190, ADR-0073) :
// RegistrationQuestionLink_une_cible_check, une seule cible ; RegistrationQuestionLink_{personnage,groupe,intrigue}_unique_key,
// index uniques partiels qui refusent deux liens identiques (même jeu, question, option et cible)
model RegistrationQuestionLink {
  id          String     @id @default(cuid())
  gameId      String
  game        Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  questionId  String
  option      String     @default("")
  characterId String?
  character   Character? @relation(fields: [characterId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  factionId   String?
  faction     Faction?   @relation(fields: [factionId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  intrigueId  String?
  intrigue    Intrigue?  @relation(fields: [intrigueId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)

  @@index([gameId])
  @@index([characterId, gameId])
  @@index([factionId, gameId])
  @@index([intrigueId, gameId])
}

// Part attendue d'une option d'une question du formulaire, ou d'un niveau d'une échelle (US-141, ADR-0062) ; hors des
// versions du formulaire
model RegistrationOptionExpectation {
  id         String   @id @default(cuid())
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  questionId String
  option     String
  share      Float
  updatedAt  DateTime @updatedAt

  @@unique([gameId, questionId, option])
}

model CharacterTrombinoscopeEntry {
  id                String    @id @default(cuid())
  // Jeu des deux personnages (US-191, ADR-0074)
  gameId            String
  viewerCharacterId String
  targetCharacterId String
  included          Boolean   @default(true)
  faceKnown         Boolean   @default(true)
  displayName       String?
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  viewerCharacter   Character @relation("TrombinoscopeViewerEntries", fields: [viewerCharacterId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  targetCharacter   Character @relation("TrombinoscopeTargetEntries", fields: [targetCharacterId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([viewerCharacterId, targetCharacterId])
  @@index([viewerCharacterId, gameId])
  @@index([targetCharacterId, gameId])
}

model Item {
  id                    String       @id @default(cuid())
  name                  String
  slug                  String       @unique
  description           String?
  quantity              Int          @default(1)
  locationText          String?
  locationCharacterId   String?
  // La base n'efface que l'identifiant à la suppression du personnage (ADR-0077)
  locationCharacter     Character?   @relation("ItemLocationCharacter", fields: [locationCharacterId, gameId], references: [id, gameId], onDelete: SetNull, onUpdate: NoAction)
  gameId                String
  game                  Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  published             Boolean      @default(true)

  characterLinks        CharacterItem[]
  intrigueLinks         IntrigueItem[]
  timelineEventLinks    TimelineEventItem[]

  @@index([gameId])
  @@index([locationCharacterId, gameId])
  // Cible des clés composées avec le jeu (US-191, ADR-0074)
  @@unique([id, gameId])
}

model Faction {
  id                    String     @id @default(cuid())
  name                  String
  pitch                 String?
  background            String?
  backgroundDocumentUrl String?
  costumeIndications    String?
  showInTrombinoscope   Boolean    @default(false)
  slug                  String     @unique
  gameId                String
  game                  Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  published             Boolean    @default(true)

  characterLinks        CharacterFaction[]
  intrigueLinks         FactionIntrigue[]
  timelineEventLinks    TimelineEventFaction[]
  documentLinks         DocumentFaction[]
  questionLinks         RegistrationQuestionLink[]

  @@index([gameId])
  // Cible des clés composées avec le jeu (US-191, ADR-0074)
  @@unique([id, gameId])
}

model Intrigue {
  id          String    @id @default(cuid())
  name        String
  pitch       String?
  description String?
  level       IntrigueLevel @default(minor)
  slug        String    @unique
  gameId      String
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  published   Boolean   @default(true)

  characterLinks CharacterIntrigue[]
  questionLinks RegistrationQuestionLink[]
  factionLinks FactionIntrigue[]
  itemLinks   IntrigueItem[]
  timelineEventLinks TimelineEventIntrigue[]

  @@index([gameId])
  // Cible des clés composées avec le jeu (US-191, ADR-0074)
  @@unique([id, gameId])
}

model TimelineEvent {
  id                    String     @id @default(cuid())
  name                  String
  slug                  String     @unique
  description           String?
  day                   Int
  time                  String
  requiredResponsibles  Int        @default(0)
  gameId                String
  game                  Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  published             Boolean    @default(true)

  characterLinks        TimelineEventCharacter[]
  factionLinks          TimelineEventFaction[]
  intrigueLinks         TimelineEventIntrigue[]
  itemLinks             TimelineEventItem[]
  responsibles          TimelineEventResponsible[]

  @@index([gameId, day, time])
  // Cible des clés composées avec le jeu (US-191, ADR-0074)
  @@unique([id, gameId])
}

model Document {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  content     String?
  documentUrl String?
  // Ancien public unique, encore écrit pour le build en service pendant un déploiement (ADR-0072)
  audience    DocumentAudience @default(targeted)
  // Rôles visés : organizers, npcs, kitchen, pjs (US-187, ADR-0072) ; la sélection avancée est characters et factions
  audiences   DocumentRole[] @default([])
  readyToSend Boolean     @default(false)
  gameId      String
  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  published   Boolean     @default(true)

  // Ancien champ « Personnage », vidé par la migration d'ADR-0072 et plus écrit : les personnages sont dans characters
  characterId String?
  character   Character?  @relation(fields: [characterId, gameId], references: [id, gameId], onDelete: SetNull, onUpdate: NoAction)
  characterLinks DocumentCharacter[]

  factionLinks DocumentFaction[]
  deliveries  SessionDocumentDelivery[]

  @@index([gameId])
  @@index([characterId, gameId])
  // Cible des clés composées avec le jeu (US-191, ADR-0074)
  @@unique([id, gameId])
}

// Liens entre éléments du contenu d'un jeu (US-191, ADR-0074) : anciennes tables implicites de Prisma, devenues des
// modèles qui portent le jeu, pour que chaque clé étrangère le compare. Les anciennes tables (_CharacterFactions…)
// restent le temps d'un déploiement, puis sont retirées (US-193).

// Ancienne table _CharacterFactions
model CharacterFaction {
  gameId      String
  characterId String
  character   Character @relation(fields: [characterId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  factionId   String
  faction     Faction @relation(fields: [factionId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)

  @@id([characterId, gameId, factionId])
  @@index([factionId, gameId])
}

// Ancienne table _CharacterIntrigues
model CharacterIntrigue {
  gameId      String
  characterId String
  character   Character @relation(fields: [characterId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  intrigueId  String
  intrigue    Intrigue @relation(fields: [intrigueId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)

  @@id([characterId, gameId, intrigueId])
  @@index([intrigueId, gameId])
}

// Ancienne table _CharacterItems
model CharacterItem {
  gameId      String
  characterId String
  character   Character @relation(fields: [characterId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  itemId      String
  item        Item @relation(fields: [itemId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)

  @@id([characterId, gameId, itemId])
  @@index([itemId, gameId])
}

// Ancienne table _DocumentCharacters
model DocumentCharacter {
  gameId      String
  documentId  String
  document    Document @relation(fields: [documentId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  characterId String
  character   Character @relation(fields: [characterId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)

  @@id([documentId, gameId, characterId])
  @@index([characterId, gameId])
}

// Ancienne table _DocumentFactions
model DocumentFaction {
  gameId     String
  documentId String
  document   Document @relation(fields: [documentId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  factionId  String
  faction    Faction @relation(fields: [factionId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)

  @@id([documentId, gameId, factionId])
  @@index([factionId, gameId])
}

// Ancienne table _FactionIntrigues
model FactionIntrigue {
  gameId     String
  factionId  String
  faction    Faction @relation(fields: [factionId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  intrigueId String
  intrigue   Intrigue @relation(fields: [intrigueId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)

  @@id([factionId, gameId, intrigueId])
  @@index([intrigueId, gameId])
}

// Ancienne table _IntrigueItems
model IntrigueItem {
  gameId     String
  intrigueId String
  intrigue   Intrigue @relation(fields: [intrigueId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  itemId     String
  item       Item @relation(fields: [itemId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)

  @@id([intrigueId, gameId, itemId])
  @@index([itemId, gameId])
}

// Ancienne table _TimelineEventCharacters
model TimelineEventCharacter {
  gameId          String
  timelineEventId String
  timelineEvent   TimelineEvent @relation(fields: [timelineEventId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  characterId     String
  character       Character @relation(fields: [characterId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)

  @@id([timelineEventId, gameId, characterId])
  @@index([characterId, gameId])
}

// Ancienne table _TimelineEventFactions
model TimelineEventFaction {
  gameId          String
  timelineEventId String
  timelineEvent   TimelineEvent @relation(fields: [timelineEventId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  factionId       String
  faction         Faction @relation(fields: [factionId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)

  @@id([timelineEventId, gameId, factionId])
  @@index([factionId, gameId])
}

// Ancienne table _TimelineEventIntrigues
model TimelineEventIntrigue {
  gameId          String
  timelineEventId String
  timelineEvent   TimelineEvent @relation(fields: [timelineEventId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  intrigueId      String
  intrigue        Intrigue @relation(fields: [intrigueId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)

  @@id([timelineEventId, gameId, intrigueId])
  @@index([intrigueId, gameId])
}

// Ancienne table _TimelineEventItems
model TimelineEventItem {
  gameId          String
  timelineEventId String
  timelineEvent   TimelineEvent @relation(fields: [timelineEventId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  itemId          String
  item            Item @relation(fields: [itemId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)

  @@id([timelineEventId, gameId, itemId])
  @@index([itemId, gameId])
}

model Session {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  date        DateTime?
  gameId      String
  game        Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  locationId  String?
  location    Location?  @relation(fields: [locationId, gameId], references: [id, gameId], onDelete: SetNull, onUpdate: NoAction)
  paymentRibUrl String?
  paymentLinkUrl String?
  // Date limite de désistement (US-040, ADR-0033) : après elle, une place n'est remboursée qu'au choix des orgas
  withdrawalDeadline DateTime?
  // Version des réglages de paiement (ADR-0036), à part de celle de la session
  paymentSettingsUpdatedAt DateTime?
  status      SessionStatus @default(scheduled)
  // Passage à « Annulée » : les copies des envois s'effacent un mois après (US-080, ADR-0044)
  cancelledAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  // Visible sur la page publique du jeu (US-019) ; non visible par défaut
  published   Boolean    @default(false)
  // Session sur laquelle celle-ci a été reportée (US-022, ADR-0029)
  postponedToSessionId String?   @unique
  postponedTo          Session?  @relation("SessionPostponements", fields: [postponedToSessionId, gameId], references: [id, gameId], onDelete: SetNull, onUpdate: NoAction)
  postponedFrom        Session?  @relation("SessionPostponements")
  carriedOverPayments  SessionPayment[] @relation("PaymentCarryOvers")
  attendances          SessionAttendance[]

  assignments SessionAssignment[]
  participants SessionParticipant[]
  timelineResponsibles TimelineEventResponsible[]
  documentDeliveries SessionDocumentDelivery[]
  trombinoscopes SessionTrombinoscope[]
  payments SessionPayment[]
  tariffs SessionTariff[]
  uploadedFiles UploadedFile[]
  registrationPeriodLink RegistrationPeriodSession?
  registrationLines RegistrationSession[]
  registrationDraws RegistrationDraw[]
  // Invitations qui visent cette session (SPEC-018, R4)
  invitedRegistrations Registration[] @relation("RegistrationInvitedSession")

  @@index([gameId])
  @@index([locationId, gameId])
  // Cible des clés composées avec le jeu (US-195, ADR-0074)
  @@unique([id, gameId])
  // Relation un-à-un composée avec le jeu : Prisma demande l'unicité de ses colonnes (déjà unique par postponedToSessionId)
  @@unique([postponedToSessionId, gameId])
}

// Vivier d'un jeu (SPEC-018, ADR-0069) : le nom de la table reste celui des anciennes périodes d'inscription
model RegistrationPeriod {
  id                String   @id @default(cuid())
  // Un seul vivier par jeu (R1)
  gameId            String   @unique
  game              Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  // Identifiant aléatoire du lien de diffusion (R32), distinct de l'id et du slug du jeu
  publicId          String   @unique
  // Ouvert et fermé à la main (R2)
  state             RegistrationPeriodState @default(draft)
  responseDelayDays Int      @default(7)
  // Prévenir l'équipe de chaque inscription reçue par le formulaire (US-083)
  notifyTeam        Boolean  @default(false)
  // Rejoueurs (R7) : allowed, flagged ou excluded (US-087, ADR-0047)
  replayPolicy      ReplayPolicy @default(allowed)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions          RegistrationPeriodSession[]
  registrations     Registration[]
  requests          RegistrationRequest[]
  draws             RegistrationDraw[]
  // Cible des clés composées avec le jeu (US-195, ADR-0074)
  @@unique([id, gameId])
}

// Session suivie par le vivier (ADR-0069) : le casting se fait sur toute session qui a une ligne
model RegistrationPeriodSession {
  id        String             @id @default(cuid())
  // Dernière demande de disponibilités ou relance (R9, R12) : une personne sans réponse n'a pas de ligne RegistrationSession
  lastRequestedAt DateTime?
  // Annonce du casting (R26) ; ensuite, chaque changement se propose ligne par ligne (R27)
  castAnnouncedAt DateTime?
  // Jeu du vivier et de la session (US-195, ADR-0074)
  gameId    String
  periodId  String
  period    RegistrationPeriod @relation(fields: [periodId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  sessionId String             @unique
  session   Session            @relation(fields: [sessionId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  // Ouverte à la pré-inscription (R6) ; proposée seulement si elle est aussi datée, à venir, ni annulée ni terminée
  open      Boolean            @default(false)
  // Sélection de la session (R22, ADR-0048)
  selectionMode        SelectionMode @default(chosen)
  organizerPicks       Int?
  weightNotDrawnBefore Boolean @default(false)
  weightBalance        Boolean @default(false)
  waitlistSize         Int     @default(5)

  @@index([periodId, gameId])
  // Relation un-à-un composée avec le jeu : Prisma demande l'unicité de ses colonnes (déjà unique par sessionId)
  @@unique([sessionId, gameId])
}

// Formulaire d'inscription d'un jeu (R8). Chaque modification crée une version immuable :
// une inscription garde la version qu'elle a remplie (R9, ADR-0019).
model RegistrationForm {
  id        String   @id @default(cuid())
  gameId    String   @unique
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions  RegistrationFormVersion[]
  // Cible des clés composées avec le jeu (US-195, ADR-0074)
  @@unique([id, gameId])
}

model RegistrationFormVersion {
  id         String           @id @default(cuid())
  // Jeu du formulaire (US-195, ADR-0074)
  gameId     String
  formId     String
  form       RegistrationForm @relation(fields: [formId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  number     Int
  // Définition validée par registrationFormDefinitionSchema (server/utils/schemas.ts)
  definition Json
  createdAt  DateTime         @default(now())

  registrations Registration[]
  requests      RegistrationRequest[]

  @@unique([formId, number])
  // Cible des clés composées avec le jeu (US-195, ADR-0074)
  @@unique([id, gameId])
  @@index([formId, gameId])
}

// Personne du vivier d'un jeu (ADR-0069) : ses réponses et ses coordonnées, une ligne par personne. Son statut pour
// chaque session est dans RegistrationSession. Les champs standards ne modifient pas la fiche du participant.
model Registration {
  id                    String                   @id @default(cuid())
  // Jeu du vivier (US-195, ADR-0074)
  gameId                String
  periodId              String
  period                RegistrationPeriod       @relation(fields: [periodId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  // Session visée par l'invitation (R4) : la personne y est inscrite si elle répond en se disant disponible
  invitedSessionId      String?
  invitedSession        Session?                 @relation("RegistrationInvitedSession", fields: [invitedSessionId, gameId], references: [id, gameId], onDelete: SetNull, onUpdate: NoAction)
  participantId         String
  participant           Participant              @relation(fields: [participantId], references: [id], onDelete: Cascade)
  // invited, received (intéressée) ou withdrawn (sortie du vivier)
  status                RegistrationStatus
  source                RegistrationSource
  invitedById           String?
  invitedBy             User?                    @relation("SentRegistrationInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  formVersionId         String?
  formVersion           RegistrationFormVersion? @relation(fields: [formVersionId, gameId], references: [id, gameId], onDelete: SetNull, onUpdate: NoAction)

  email                 String
  firstName             String?
  lastName              String?
  facebookName          String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  dietary               String?
  healthConsentAt       DateTime?
  charterAcceptedAt     DateTime?
  // Réponses aux questions propres au jeu, par identifiant de question (US-081, ADR-0045)
  questionAnswers       Json?

  invitationSentAt      DateTime?
  // Dernière relance par les orgas (US-005)
  lastRemindedAt        DateTime?
  responseDueAt         DateTime?
  respondedAt           DateTime?
  withdrawnAt           DateTime?
  // Organisatrice qui a retiré la personne (US-005) ; null pour un refus ou un désistement par le lien
  withdrawnById         String?
  withdrawnBy           User?                    @relation("RegistrationWithdrawals", fields: [withdrawnById], references: [id], onDelete: SetNull)
  // Réponse à la question d'équilibre (US-091) ; null : peu importe
  balancePreference     String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  affinities            RegistrationAffinity[]
  sessionLines          RegistrationSession[]
  links                 RegistrationLink[]
  // Personnages réservés en attendant la confirmation (US-100, ADR-0051)
  reservedAssignments   SessionAssignment[]

  @@unique([periodId, participantId])
  @@index([participantId])
  @@index([invitedSessionId, gameId])
  @@index([formVersionId, gameId])
  @@index([invitedById])
  @@index([withdrawnById])
  // Cible des clés composées avec le jeu (US-195, ADR-0074)
  @@unique([id, gameId])
  @@index([periodId, gameId])
}

// Statut d'une personne du vivier pour une session (R17, ADR-0069)
model RegistrationSession {
  id             String       @id @default(cuid())
  // Jeu de l'inscription et de la session (US-195, ADR-0074)
  gameId         String
  registrationId String
  registration   Registration @relation(fields: [registrationId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  sessionId      String
  session        Session      @relation(fields: [sessionId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  // preregistered, unavailable, waitlisted, retained, confirmed, transferred ou cancelled
  status         RegistrationSessionStatus
  // Dernière réponse de la personne : available, unavailable ; null sans réponse (R28, R29)
  answer         AvailabilityAnswer?
  answeredAt     DateTime?
  waitlistPosition Int?
  // Relance d'une place retenue pas confirmée
  lastRemindedAt DateTime?
  // Confirmation d'une place retenue (R20 de SPEC-001)
  responseDueAt  DateTime?
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  // Organisatrice qui a retiré la personne ; null si elle a annulé elle-même
  cancelledById  String?
  cancelledBy    User?        @relation("RegistrationSessionCancellations", fields: [cancelledById], references: [id], onDelete: SetNull)
  // Organisatrice qui a retenu la personne, à la main ou en enregistrant le cast ; null pour le tirage
  retainedById   String?
  retainedBy     User?        @relation("RegistrationSessionRetentions", fields: [retainedById], references: [id], onDelete: SetNull)
  // Dernier statut annoncé à la personne (ADR-0047)
  announcedStatus RegistrationSessionStatus?
  announcedAt    DateTime?
  // Statut pour lequel l'équipe a écarté l'email à la personne (R27)
  ignoredStatus  RegistrationSessionStatus?
  // Repère « réponses modifiées », jusqu'à ce qu'une organisatrice le marque comme lu (R16)
  answersChangedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([registrationId, sessionId])
  @@index([sessionId, status])
  @@index([cancelledById])
  @@index([retainedById])
  @@index([registrationId, gameId])
  @@index([sessionId, gameId])
}

// Lien personnel d'une personne du vivier (ADR-0070) : un par email envoyé, tous valables jusqu'à un renouvellement par
// l'équipe ou sa sortie du vivier. Seule l'empreinte du jeton est gardée (ADR-0018)
model RegistrationLink {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  createdAt      DateTime     @default(now())

  @@index([registrationId])
}

// Formulaire public envoyé, en attente de la confirmation de l'email (US-084, US-085, ADR-0046) : ni fiche ni
// inscription avant la confirmation ; supprimé à la confirmation, ou au bout de 7 jours
model RegistrationRequest {
  id            String             @id @default(cuid())
  // Jeu du vivier (US-195, ADR-0074)
  gameId        String
  periodId      String
  period        RegistrationPeriod @relation(fields: [periodId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  email         String
  // Réponses validées : champs standards, affinités, questions et disponibilités
  answers       Json
  formVersionId String?
  formVersion   RegistrationFormVersion? @relation(fields: [formVersionId, gameId], references: [id, gameId], onDelete: SetNull, onUpdate: NoAction)
  // SHA-256 du jeton du lien envoyé, qui devient le lien personnel (ADR-0018)
  tokenHash     String             @unique
  createdAt     DateTime           @default(now())

  @@index([periodId, gameId])
  @@index([createdAt])
  @@index([formVersionId, gameId])
}

// Tirage au sort d'une période (US-093, US-094, ADR-0048) : graine, réglages et résultat, pour le rejouer à l'identique
model RegistrationDraw {
  id            String             @id @default(cuid())
  // Jeu du vivier (US-195, ADR-0074)
  gameId        String
  periodId      String
  period        RegistrationPeriod @relation(fields: [periodId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  // Session tirée (R22) ; null : ancien tirage d'une période, gardé au journal et non annulable
  sessionId     String?
  session       Session?           @relation(fields: [sessionId, gameId], references: [id, gameId], onDelete: SetNull, onUpdate: NoAction)
  seed          String
  settings      Json
  result        Json
  createdById   String?
  createdBy     User?              @relation("RegistrationDrawAuthors", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?              @relation("RegistrationDrawCancellations", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([periodId, gameId])
  @@index([sessionId, gameId])
  @@index([createdById])
  @@index([cancelledById])
}

// Une personne ou une relation citée dans une affinité, une par ligne (US-082, ADR-0045)
model RegistrationAffinity {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  // wantWith, notWith, refusedRelations ou avoid
  kind           AffinityKind
  text           String
  position       Int
  // Personne du jeu rattachée par l'équipe (US-095, ADR-0049) ; effacer la fiche supprime la ligne
  targetParticipantId String?
  targetParticipant   Participant? @relation("AffinityTargets", fields: [targetParticipantId], references: [id], onDelete: Cascade)
  // La ligne ne vise personne du jeu
  targetUnknown  Boolean      @default(false)

  @@index([registrationId])
  @@index([targetParticipantId])
}

model SessionAssignment {
  id          String   @id @default(cuid())
  // Jeu de la session (US-195, ADR-0074)
  gameId      String
  sessionId   String
  characterId String
  participantId String?
  photoUrl    String?
  notes       String?
  // Cadenas : l'assistant de casting ne touche pas à la ligne (US-100, ADR-0051)
  locked      Boolean  @default(false)
  // Personnage réservé à une personne retenue qui n'a pas encore confirmé ; participantId reste vide (US-100)
  reservedRegistrationId String?
  reservedRegistration   Registration? @relation(fields: [reservedRegistrationId, gameId], references: [id, gameId], onDelete: SetNull, onUpdate: NoAction)
  session     Session  @relation(fields: [sessionId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  character   Character @relation(fields: [characterId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([sessionId, characterId])
  @@index([reservedRegistrationId, gameId])
  @@index([characterId, gameId])
  @@index([participantId])
  @@index([sessionId, gameId])
}

model SessionParticipant {
  id            String      @id @default(cuid())
  sessionId     String
  participantId String
  role          SessionRole
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([sessionId, participantId, role])
  @@index([participantId])
}

model Location {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  address     String?
  notes       String?
  gameId      String
  game        Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  published   Boolean    @default(true)

  sessions    Session[]

  @@index([gameId])
  // Cible des clés composées avec le jeu (US-195, ADR-0074)
  @@unique([id, gameId])
}

model Participant {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  email       String?
  phone       String?
  // Compte rattaché par l'adresse confirmée (US-070, ADR-0041)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Photo refusée (US-109, ADR-0054) : aucune photo de la personne dans le cast ni les trombinoscopes
  photoRefusedAt DateTime?
  // Vidé par la migration d'ADR-0040 : les notes vivent sur ParticipantGame. Colonne à supprimer
  notes       String?
  gameLinks   ParticipantGame[]
  published   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignments SessionAssignment[]
  sessionRoles SessionParticipant[]
  timelineResponsibilities TimelineEventResponsible[]
  documentDeliveries SessionDocumentDelivery[]
  trombinoscopes SessionTrombinoscope[]
  payments SessionPayment[]
  receivedPaymentTransfers SessionPayment[] @relation("PaymentTransfers")
  registrations Registration[]
  attendances SessionAttendance[]
  affinityMentions RegistrationAffinity[] @relation("AffinityTargets")

  @@index([userId])
}

model SessionPayment {
  id                  String      @id @default(cuid())
  // Jeu de la session (US-195, ADR-0074)
  gameId              String
  sessionId           String
  participantId       String
  paidAt              DateTime?
  paymentEmailSentAt  DateTime?
  paymentReminderSentAt DateTime?
  // Session annulée ou reportée (US-023, ADR-0029) : to_refund, refunded ou carried_over
  refundStatus        RefundStatus?
  refundedAt          DateTime?
  carriedOverToSessionId String?
  // Tarif choisi par l'organisatrice ; sinon celui du rôle de la personne (US-031, ADR-0032)
  tariffId            String?
  // Place offerte : rien à payer, sans tarif (US-041)
  offered             Boolean     @default(false)
  // Paiement d'une personne partie, transféré au remplaçant (US-039, ADR-0033)
  transferredToParticipantId String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  session             Session     @relation(fields: [sessionId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  participant         Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  transferredTo       Participant? @relation("PaymentTransfers", fields: [transferredToParticipantId], references: [id], onDelete: SetNull)
  carriedOverTo       Session?    @relation("PaymentCarryOvers", fields: [carriedOverToSessionId, gameId], references: [id, gameId], onDelete: SetNull, onUpdate: NoAction)
  tariff              SessionTariff? @relation(fields: [tariffId], references: [id], onDelete: SetNull)
  instalments         SessionPaymentInstalment[]

  @@unique([sessionId, participantId])
  @@index([participantId])
  @@index([tariffId])
  @@index([transferredToParticipantId])
  @@index([carriedOverToSessionId, gameId])
  @@index([sessionId, gameId])
}

// Tarif de la PAF d'une session (US-031, ADR-0032) : montant en centimes d'euro
model SessionTariff {
  id           String   @id @default(cuid())
  sessionId    String
  name         String
  amountCents  Int
  // pj, pnj, organizer ou kitchen : tarif appliqué par défaut à ce rôle
  defaultRole  TariffRole?
  // Tarif solidaire : de soutien s'il est plus cher que sa base, réduit s'il l'est moins (US-033)
  baseTariffId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session            Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  baseTariff         SessionTariff?   @relation("TariffBase", fields: [baseTariffId], references: [id], onDelete: SetNull)
  solidarityTariffs  SessionTariff[]  @relation("TariffBase")
  payments           SessionPayment[]

  @@unique([sessionId, defaultRole])
  @@index([baseTariffId])
}

// Versement reçu pour un paiement (US-032) : le reçu est la somme des versements
model SessionPaymentInstalment {
  id          String   @id @default(cuid())
  paymentId   String
  amountCents Int
  receivedAt  DateTime
  createdAt   DateTime @default(now())

  payment     SessionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model SessionTrombinoscope {
  id                String      @id @default(cuid())
  // Jeu de la session (US-195, ADR-0074)
  gameId            String
  sessionId         String
  viewerCharacterId String
  participantId     String
  fileName          String
  contentHtml       String
  contentPdfBase64  String?
  missingPhotos     Int         @default(0)
  sourceHash        String?
  // Cartes du trombinoscope, pour le lire dans « Je participe » (US-079, ADR-0044)
  contentJson       Json?
  generatedAt       DateTime    @default(now())

  session           Session     @relation(fields: [sessionId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  viewerCharacter   Character   @relation("TrombinoscopeViewerDocuments", fields: [viewerCharacterId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  participant       Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, viewerCharacterId, participantId])
  @@index([participantId])
  @@index([viewerCharacterId, gameId])
  @@index([sessionId, gameId])
}

model SessionDocumentDelivery {
  id            String      @id @default(cuid())
  // Jeu de la session (US-195, ADR-0074)
  gameId        String
  sessionId     String
  participantId String
  documentId    String?
  characterId   String?
  kind          DeliveryKind @default(document)
  contentHash   String?
  sentAt        DateTime    @default(now())
  // Copie de ce qui est parti (US-078, ADR-0044) : PDF joint, ce qui se lit dans la page, et leur taille
  copyPdf       Bytes?
  copyContent   Json?
  copySize      Int?

  session       Session     @relation(fields: [sessionId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  document      Document?   @relation(fields: [documentId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  character     Character?  @relation(fields: [characterId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)

  @@index([sessionId, kind])
  @@index([participantId])
  @@index([documentId, gameId])
  @@index([characterId, gameId])
  @@index([sessionId, gameId])
}

model TimelineEventResponsible {
  id              String        @id @default(cuid())
  // Jeu de la session (US-195, ADR-0074)
  gameId          String
  sessionId       String
  timelineEventId String
  participantId   String
  session         Session       @relation(fields: [sessionId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  timelineEvent   TimelineEvent @relation(fields: [timelineEventId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  participant     Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, timelineEventId, participantId])
  @@index([participantId])
  @@index([timelineEventId, gameId])
  @@index([sessionId, gameId])
}

model ParticipantGame {
  id        String   @id @default(cuid())
  participantId String
  gameId    String
  // Notes de l'équipe de ce jeu sur la personne (US-069, ADR-0040)
  notes     String?
  createdAt DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([participantId, gameId])
  @@index([gameId])
}

model UploadedFile {
  id        String   @id @default(cuid())
  kind      UploadKind
  filename  String   @unique
  url       String   @unique
  // Jeu du fichier, toujours connu : il compte dans son stockage, et la clé de sa session le compare (US-195)
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sessionId String?
  session   Session? @relation(fields: [sessionId, gameId], references: [id, gameId], onDelete: Cascade, onUpdate: NoAction)
  // Octets ; vide pour un fichier d'avant US-066, relevé sur le disque au premier calcul
  size      Int?
  createdAt DateTime @default(now())

  @@index([kind])
  @@index([gameId])
  @@index([sessionId, gameId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  // admin ou user (ADR-0038)
  role      UserRole @default(user)
  // Incrémenté pour invalider toutes les sessions ouvertes (déconnexion partout, changement de mot de passe)
  sessionVersion Int @default(0)
  // Adresse confirmée (ADR-0039) : vide seulement après une inscription libre, jusqu'au lien de confirmation
  emailConfirmedAt DateTime? @default(now())
  // Compte désactivé par l'administratrice : plus de connexion
  disabledAt DateTime?
  // Plafond des fichiers téléversés dans les jeux du compte (US-066)
  storageQuotaMb Int @default(500)
  // Coordonnées tenues par la personne, recopiées sur ses fiches et inscriptions (US-074, ADR-0042)
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  dietary               String?
  healthConsentAt       DateTime?
  // Premier enregistrement des coordonnées : avant, rien n'est recopié
  profileUpdatedAt      DateTime?
  // Conditions d'utilisation acceptées (US-111, ADR-0055) : version (date) et moment de l'acceptation
  termsAcceptedVersion  String?
  termsAcceptedAt       DateTime?
  // Dernière activité (US-112, ADR-0056) : après 23 mois sans, un avertissement ; après 24, l'effacement
  lastSeenAt            DateTime @default(now())
  inactivityWarnedAt    DateTime?
  // Compte inactif qu'on ne peut pas effacer (jeux possédés, dernière administratrice), signalé une fois
  inactivityReportedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountTokens AccountToken[]
  participants Participant[]
  ownedGames Game[] @relation("OwnedGames")
  proposedTransfers Game[] @relation("GameTransfers")
  gameShares GameShare[]
  sentInvitations GameInvitation[] @relation("SentGameInvitations")
  acceptedInvitations GameInvitation[] @relation("AcceptedGameInvitations")
  sentRegistrationInvitations Registration[] @relation("SentRegistrationInvitations")
  registrationWithdrawals Registration[] @relation("RegistrationWithdrawals")
  registrationSessionCancellations RegistrationSession[] @relation("RegistrationSessionCancellations")
  registrationSessionRetentions RegistrationSession[] @relation("RegistrationSessionRetentions")
  registrationDraws RegistrationDraw[] @relation("RegistrationDrawAuthors")
  cancelledRegistrationDraws RegistrationDraw[] @relation("RegistrationDrawCancellations")
  aiAuthorizations AiAuthorization[]
  aiLogEntries AiLogEntry[]
}

// Lien à usage unique envoyé par email : confirmation, changement d'adresse, mot de passe (ADR-0039)
model AccountToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // confirm | email | password
  kind      AccountTokenKind
  tokenHash String    @unique
  // Nouvelle adresse, pour un changement d'email
  email     String?
  // Mot de passe choisi à l'inscription : appliqué par ce lien seulement, pas par celui d'une autre inscription
  passwordHash String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
}

model GameShare {
  id        String   @id @default(cuid())
  gameId    String
  userId    String
  role      GameShareRole @default(organizer)
  createdAt DateTime @default(now())

  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId])
}

// Ancien slug d'un jeu (US-045, ADR-0035) : l'ancienne adresse de la page publique redirige vers la nouvelle
model GameSlugRedirect {
  slug      String   @id
  gameId    String
  createdAt DateTime @default(now())

  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model GameInvitation {
  id           String    @id @default(cuid())
  gameId       String
  email        String
  // Jeton en clair des invitations d'avant ADR-0034 : plus écrit, vide après la migration
  token        String?   @unique
  // Empreinte SHA-256 du jeton du lien (ADR-0034) : le jeton lui-même n'est pas gardé
  tokenHash    String?   @unique
  status       GameInvitationStatus @default(pending)
  // share : co-organisation ; bequest : legs d'une copie en attente (gameId = la copie, ADR-0025)
  kind         GameInvitationKind @default(share)
  invitedById  String
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  game         Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  invitedBy    User      @relation("SentGameInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy   User?     @relation("AcceptedGameInvitations", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([gameId])
  @@index([email])
  @@index([invitedById])
  @@index([acceptedById])
}

model SmtpSettings {
  id                String   @id @default("default")
  enabled           Boolean  @default(false)
  host              String
  port              Int      @default(587)
  secure            Boolean  @default(false)
  username          String?
  passwordEncrypted String?
  fromEmail         String
  fromName          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Confirmation de présence à une session reportée (US-024, ADR-0029)
model SessionAttendance {
  id             String      @id @default(cuid())
  sessionId      String
  participantId  String
  // pending, confirmed, declined ou released ; le délai dépassé s'évalue à la lecture (ADR-0020)
  status         AttendanceStatus @default(pending)
  // SHA-256 du jeton du lien personnel (ADR-0018) ; null quand le lien est invalidé
  tokenHash      String?     @unique
  responseDueAt  DateTime
  invitationSentAt DateTime?
  lastRemindedAt DateTime?
  respondedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  session        Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantId])
  @@index([participantId])
}

// Violations de la CSP en mode rapport (US-106, ADR-0053), comptées sans adresse IP ni compte : la ressource bloquée
// est réduite à son origine, la page à son chemin
model CspViolation {
  id           String   @id @default(cuid())
  directive    String
  blockedUri   String
  documentPath String
  count        Int      @default(1)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  @@unique([directive, blockedUri, documentPath])
}

// Assistant d'IA (client OAuth) qui se branche sur Limbus (US-121, ADR-0058) : identifié par l'URL de son document
// de métadonnées (CIMD), ou inscrit dynamiquement (DCR, identifiant aléatoire)
model AiClient {
  id           String   @id
  name         String
  redirectUris String[]
  dynamic      Boolean  @default(false)
  // CIMD : document relu au plus tard une heure après sa dernière lecture
  fetchedAt    DateTime @default(now())
  // Inscrit dynamiquement et jamais autorisé : effacé au bout de 24 heures
  usedAt       DateTime?
  createdAt    DateTime @default(now())

  requests       AiAuthorizationRequest[]
  authorizations AiAuthorization[]
}

// Demande d'autorisation en cours : page « Autoriser » (10 minutes), puis code à échanger (60 secondes)
model AiAuthorizationRequest {
  id              String   @id @default(cuid())
  clientId        String
  client          AiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUri     String
  state           String?
  codeChallenge   String
  // Empreinte du code rendu à l'assistant, et autorisation qu'il permet d'obtenir
  codeHash        String?  @unique
  authorizationId String?
  authorization   AiAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([expiresAt])
  @@index([clientId])
  @@index([authorizationId])
}

// Accord donné par un compte à un assistant (SPEC-014, R4 à R6) : effacé à sa fin, le journal en garde la trace
model AiAuthorization {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId       String
  client         AiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  canWrite       Boolean  @default(false)
  // Version de session du compte à l'autorisation : revokeUserSessions la coupe
  sessionVersion Int
  lastUsedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  games    AiAuthorizationGame[]
  tokens   AiToken[]
  requests AiAuthorizationRequest[]

  @@index([userId])
  @@index([clientId])
}

model AiAuthorizationGame {
  authorizationId String
  authorization   AiAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  gameId          String
  game            Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([authorizationId, gameId])
  @@index([gameId])
}

// Jeton d'un assistant, gardé en empreinte : accès (une heure) ou rafraîchissement (renouvelé à chaque usage)
model AiToken {
  hash            String          @id
  authorizationId String
  authorization   AiAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  kind            AiTokenKind
  expiresAt       DateTime
  // Rafraîchissement déjà renouvelé : le présenter de nouveau fait tomber l'autorisation
  usedAt          DateTime?
  createdAt       DateTime        @default(now())

  @@index([authorizationId])
  @@index([expiresAt])
}

// Journal des assistants (SPEC-014, R13), gardé un an : autorisations et écritures. Effacer le compte efface son
// nom, effacer le jeu efface ses lignes
model AiLogEntry {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  gameId          String?
  game            Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  clientName      String
  authorizationId String?
  action          String
  tool            String?
  targetType      String?
  targetId        String?
  targetName      String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([gameId])
  @@index([createdAt])
}

