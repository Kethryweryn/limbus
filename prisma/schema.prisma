generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id             String     @id @default(cuid())
  title          String
  description    String
  noteIntention  String?
  teaserUrl      String?
  slug           String     @unique
  ownerId        String?
  owner          User?      @relation("OwnedGames", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  published      Boolean    @default(true)
  publicPage     Boolean    @default(false)

  characters     Character[]
  factions       Faction[]
  intrigues      Intrigue[]
  items          Item[]
  timelineEvents TimelineEvent[]
  sessions       Session[]
  documents      Document[]
  locations      Location[]
  uploadedFiles  UploadedFile[]
  participantLinks ParticipantGame[]
  shares         GameShare[]
  invitations    GameInvitation[]
  registrationPeriods RegistrationPeriod[]
  registrationForm RegistrationForm?

  @@index([ownerId])
}

model Character {
  id                    String     @id @default(cuid())
  name                  String
  type                  String     @default("pj")
  pitch                 String?
  background            String?
  backgroundDocumentUrl String?
  sheetReadyToSend      Boolean    @default(false)
  costumeIndications    String?
  excludeFromTrombinoscope Boolean @default(false)
  trombinoscopeFaceHidden  Boolean @default(false)
  trombinoscopePhotoUrl    String?
  trombinoscopeNote        String?
  trombinoscopeDisplayName String?
  slug                  String     @unique
  gameId                String
  game                  Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  published             Boolean    @default(true)

  factions              Faction[]  @relation("CharacterFactions")
  intrigues             Intrigue[] @relation("CharacterIntrigues")
  documents             Document[]
  targetedDocuments     Document[] @relation("DocumentCharacters")
  sessionAssignments    SessionAssignment[]
  items                 Item[]      @relation("CharacterItems")
  locatedItems          Item[]      @relation("ItemLocationCharacter")
  timelineEvents        TimelineEvent[] @relation("TimelineEventCharacters")
  documentDeliveries    SessionDocumentDelivery[]
  trombinoscopeViewerEntries CharacterTrombinoscopeEntry[] @relation("TrombinoscopeViewerEntries")
  trombinoscopeTargetEntries CharacterTrombinoscopeEntry[] @relation("TrombinoscopeTargetEntries")
  trombinoscopeDocuments SessionTrombinoscope[] @relation("TrombinoscopeViewerDocuments")
}

model CharacterTrombinoscopeEntry {
  id                String    @id @default(cuid())
  viewerCharacterId String
  targetCharacterId String
  included          Boolean   @default(true)
  faceKnown         Boolean   @default(true)
  displayName       String?
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  viewerCharacter   Character @relation("TrombinoscopeViewerEntries", fields: [viewerCharacterId], references: [id], onDelete: Cascade)
  targetCharacter   Character @relation("TrombinoscopeTargetEntries", fields: [targetCharacterId], references: [id], onDelete: Cascade)

  @@unique([viewerCharacterId, targetCharacterId])
  @@index([targetCharacterId])
}

model Item {
  id                    String       @id @default(cuid())
  name                  String
  slug                  String       @unique
  description           String?
  quantity              Int          @default(1)
  locationText          String?
  locationCharacterId   String?
  locationCharacter     Character?   @relation("ItemLocationCharacter", fields: [locationCharacterId], references: [id], onDelete: SetNull)
  gameId                String
  game                  Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  published             Boolean      @default(true)

  characters            Character[]   @relation("CharacterItems")
  intrigues             Intrigue[]    @relation("IntrigueItems")
  timelineEvents        TimelineEvent[] @relation("TimelineEventItems")
}

model Faction {
  id                    String     @id @default(cuid())
  name                  String
  pitch                 String?
  background            String?
  backgroundDocumentUrl String?
  costumeIndications    String?
  showInTrombinoscope   Boolean    @default(false)
  slug                  String     @unique
  gameId                String
  game                  Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  published             Boolean    @default(true)

  characters            Character[] @relation("CharacterFactions")
  intrigues             Intrigue[]  @relation("FactionIntrigues")
  timelineEvents        TimelineEvent[] @relation("TimelineEventFactions")
  documents             Document[]  @relation("DocumentFactions")
}

model Intrigue {
  id          String    @id @default(cuid())
  name        String
  pitch       String?
  description String?
  level       String    @default("minor")
  slug        String    @unique
  gameId      String
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  published   Boolean   @default(true)

  characters  Character[] @relation("CharacterIntrigues")
  factions    Faction[]   @relation("FactionIntrigues")
  items       Item[]      @relation("IntrigueItems")
  timelineEvents TimelineEvent[] @relation("TimelineEventIntrigues")
}

model TimelineEvent {
  id                    String     @id @default(cuid())
  name                  String
  slug                  String     @unique
  description           String?
  day                   Int
  time                  String
  requiredResponsibles  Int        @default(0)
  gameId                String
  game                  Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  published             Boolean    @default(true)

  characters            Character[] @relation("TimelineEventCharacters")
  factions              Faction[]   @relation("TimelineEventFactions")
  intrigues             Intrigue[]  @relation("TimelineEventIntrigues")
  items                 Item[]      @relation("TimelineEventItems")
  responsibles          TimelineEventResponsible[]

  @@index([gameId, day, time])
}

model Document {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  content     String?
  documentUrl String?
  audience    String      @default("targeted")
  readyToSend Boolean     @default(false)
  gameId      String
  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  published   Boolean     @default(true)

  characterId String?
  character   Character?  @relation(fields: [characterId], references: [id], onDelete: SetNull)
  characters  Character[]  @relation("DocumentCharacters")

  factions    Faction[]   @relation("DocumentFactions")
  deliveries  SessionDocumentDelivery[]
}

model Session {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  date        DateTime?
  gameId      String
  game        Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  locationId  String?
  location    Location?  @relation(fields: [locationId], references: [id])
  paymentRibUrl String?
  paymentLinkUrl String?
  status      String     @default("scheduled")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  published   Boolean    @default(true)

  assignments SessionAssignment[]
  participants SessionParticipant[]
  timelineResponsibles TimelineEventResponsible[]
  documentDeliveries SessionDocumentDelivery[]
  trombinoscopes SessionTrombinoscope[]
  payments SessionPayment[]
  uploadedFiles UploadedFile[]
  registrationPeriodLink RegistrationPeriodSession?
  registrations Registration[]
}

// Période d'inscription : recrutement des PJ de sessions précises (scope "sessions")
// ou de tout le jeu (scope "game", inscription permanente). Voir SPEC-001 et ADR-0019.
model RegistrationPeriod {
  id                String   @id @default(cuid())
  gameId            String
  game              Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name              String
  scope             String   @default("sessions")
  // Identifiant aléatoire du lien de diffusion (R32), distinct de l'id et du slug du jeu
  publicId          String   @unique
  entryMode         String   @default("invitation")
  selectionMode     String   @default("chosen")
  // Clôture effective : state "closed", ou state "open" et closesAt passé (ADR-0020)
  state             String   @default("draft")
  closesAt          DateTime?
  responseDelayDays Int      @default(7)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions          RegistrationPeriodSession[]
  registrations     Registration[]

  @@index([gameId])
}

model RegistrationPeriodSession {
  id        String             @id @default(cuid())
  periodId  String
  period    RegistrationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  // Une session n'appartient qu'à une période d'inscription dédiée (R1)
  sessionId String             @unique
  session   Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seats     Int

  @@index([periodId])
}

// Formulaire d'inscription d'un jeu (R8). Chaque modification crée une version immuable :
// une inscription garde la version qu'elle a remplie (R9, ADR-0019).
model RegistrationForm {
  id        String   @id @default(cuid())
  gameId    String   @unique
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions  RegistrationFormVersion[]
}

model RegistrationFormVersion {
  id         String           @id @default(cuid())
  formId     String
  form       RegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  number     Int
  // Définition validée par registrationFormDefinitionSchema (server/utils/schemas.ts)
  definition Json
  createdAt  DateTime         @default(now())

  registrations Registration[]

  @@unique([formId, number])
}

// Inscription d'une personne à une période d'inscription (ADR-0019). Les champs standards sont
// saisis à chaque inscription et ne modifient pas la fiche du participant (R14).
model Registration {
  id                    String                   @id @default(cuid())
  periodId              String
  period                RegistrationPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  // Session attribuée ; l'inscription reste si la session est supprimée
  sessionId             String?
  session               Session?                 @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  participantId         String
  participant           Participant              @relation(fields: [participantId], references: [id], onDelete: Cascade)
  status                String
  source                String
  invitedById           String?
  invitedBy             User?                    @relation("SentRegistrationInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  formVersionId         String?
  formVersion           RegistrationFormVersion? @relation(fields: [formVersionId], references: [id], onDelete: SetNull)

  email                 String
  firstName             String?
  lastName              String?
  facebookName          String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  dietary               String?
  healthConsentAt       DateTime?
  charterAcceptedAt     DateTime?

  // SHA-256 du jeton du lien personnel (ADR-0018) ; null quand le lien est invalidé
  tokenHash             String?                  @unique
  invitationSentAt      DateTime?
  responseDueAt         DateTime?
  respondedAt           DateTime?
  confirmedAt           DateTime?
  withdrawnAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@unique([periodId, participantId])
  @@index([sessionId])
  @@index([participantId])
}

model SessionAssignment {
  id          String   @id @default(cuid())
  sessionId   String
  characterId String
  participantId String?
  photoUrl    String?
  notes       String?
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id])

  @@unique([sessionId, characterId])
}

model SessionParticipant {
  id            String      @id @default(cuid())
  sessionId     String
  participantId String
  role          String
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantId, role])
  @@index([participantId])
}

model Location {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  address     String?
  notes       String?
  gameId      String
  game        Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  published   Boolean    @default(true)

  sessions    Session[]
}

model Participant {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  email       String?
  phone       String?
  notes       String?
  gameLinks   ParticipantGame[]
  published   Boolean    @default(true)
  updatedAt   DateTime   @updatedAt

  assignments SessionAssignment[]
  sessionRoles SessionParticipant[]
  timelineResponsibilities TimelineEventResponsible[]
  documentDeliveries SessionDocumentDelivery[]
  trombinoscopes SessionTrombinoscope[]
  payments SessionPayment[]
  registrations Registration[]
}

model SessionPayment {
  id                  String      @id @default(cuid())
  sessionId           String
  participantId       String
  paidAt              DateTime?
  paymentEmailSentAt  DateTime?
  paymentReminderSentAt DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  session             Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant         Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantId])
  @@index([participantId])
}

model SessionTrombinoscope {
  id                String      @id @default(cuid())
  sessionId         String
  viewerCharacterId String
  participantId     String
  fileName          String
  contentHtml       String
  contentPdfBase64  String?
  missingPhotos     Int         @default(0)
  generatedAt       DateTime    @default(now())

  session           Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  viewerCharacter   Character   @relation("TrombinoscopeViewerDocuments", fields: [viewerCharacterId], references: [id], onDelete: Cascade)
  participant       Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, viewerCharacterId, participantId])
  @@index([participantId])
}

model SessionDocumentDelivery {
  id            String      @id @default(cuid())
  sessionId     String
  participantId String
  documentId    String?
  characterId   String?
  kind          String      @default("document")
  sentAt        DateTime    @default(now())

  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  document      Document?   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  character     Character?  @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([sessionId, kind])
  @@index([participantId])
  @@index([documentId])
  @@index([characterId])
}

model TimelineEventResponsible {
  id              String        @id @default(cuid())
  sessionId       String
  timelineEventId String
  participantId   String
  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  timelineEvent   TimelineEvent @relation(fields: [timelineEventId], references: [id], onDelete: Cascade)
  participant     Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, timelineEventId, participantId])
  @@index([participantId])
  @@index([timelineEventId])
}

model ParticipantGame {
  id        String   @id @default(cuid())
  participantId String
  gameId    String
  createdAt DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([participantId, gameId])
  @@index([gameId])
}

model UploadedFile {
  id        String   @id @default(cuid())
  kind      String
  filename  String   @unique
  url       String   @unique
  gameId    String?
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([kind])
  @@index([gameId])
  @@index([sessionId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("organizer")
  // Incrémenté pour invalider toutes les sessions ouvertes (déconnexion partout, changement de mot de passe)
  sessionVersion Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedGames Game[] @relation("OwnedGames")
  gameShares GameShare[]
  sentInvitations GameInvitation[] @relation("SentGameInvitations")
  acceptedInvitations GameInvitation[] @relation("AcceptedGameInvitations")
  sentRegistrationInvitations Registration[] @relation("SentRegistrationInvitations")
}

model GameShare {
  id        String   @id @default(cuid())
  gameId    String
  userId    String
  role      String   @default("organizer")
  createdAt DateTime @default(now())

  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId])
}

model GameInvitation {
  id           String    @id @default(cuid())
  gameId       String
  email        String
  token        String    @unique
  status       String    @default("pending")
  invitedById  String
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  game         Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  invitedBy    User      @relation("SentGameInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy   User?     @relation("AcceptedGameInvitations", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([gameId])
  @@index([email])
  @@index([invitedById])
}

model SmtpSettings {
  id                String   @id @default("default")
  enabled           Boolean  @default(false)
  host              String
  port              Int      @default(587)
  secure            Boolean  @default(false)
  username          String?
  passwordEncrypted String?
  fromEmail         String
  fromName          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
