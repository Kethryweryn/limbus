DATABASE_URL="postgresql://user:password@localhost:5432/limbus"
NODE_ENV="production"
JWT_SECRET="change-me"
# Optional but recommended. If omitted, JWT_SECRET is used to encrypt the SMTP password.
SMTP_ENCRYPTION_SECRET="change-me"
PUBLIC_APP_URL="https://limbuslarp.fr"
